applicationsets:
  ceph-csi:
    namespace: argocd

    goTemplate: true
    goTemplateOptions: ["missingkey=error"]

    generators:
      - merge:
          mergeKeys:
            - name
          generators:
            - clusters:
                selector:
                  matchLabels:
                    env: downstream
            - list:
                elements:
                  - name: andromeda
                  - name: phoenix

    template:
      metadata:
        name: 'ceph-csi-{{ .name }}'
      spec:
        project: default
        sources:
          - repoURL: 'https://ceph.github.io/csi-charts'
            chart: ceph-csi-cephfs
            targetRevision: 3.16.2
            helm:
              valueFiles:
                - $myrepo/ceph-csi/values.yaml
              parameters:
                - name: csiConfig[0].clusterID
                  value: ${ceph_cluster_id}
                - name: storageClass.clusterID
                  value: ${ceph_cluster_id}
          - repoURL: https://github.com/richardpct/helm-example.git
            targetRevision: add-ceph
            ref: myrepo
        destination:
          name: '{{ .name }}'
          namespace: ceph-csi
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
          syncOptions:
            - CreateNamespace=false

  cilium-l2:
    goTemplate: true
    goTemplateOptions: ["missingkey=error"]

    generators:
      - merge:
          mergeKeys:
            - name
          generators:
            - clusters:
                selector:
                  matchLabels:
                    env: downstream
            - list:
                elements:
                  - name: andromeda
                    start_cilium_vip: "192.168.1.101"
                    stop_cilium_vip: "192.168.1.109"
                  - name: phoenix
                    start_cilium_vip: "192.168.1.111"
                    stop_cilium_vip: "192.168.1.119"

    template:
      metadata:
        name: 'cilium-l2-{{ .name }}'
      spec:
        project: default
        source:
          repoURL: 'https://github.com/richardpct/helm-example.git'
          targetRevision: HEAD
          path: cilium-l2
          helm:
            values: |-
              start_cilium_vip: "{{ .start_cilium_vip }}"
              stop_cilium_vip: "{{ .stop_cilium_vip }}"
        destination:
          name: '{{ .name }}'
          namespace: web
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
          syncOptions:
            - CreateNamespace=true

  multi-cluster-web:
    namespace: argocd

    goTemplate: true
    goTemplateOptions: ["missingkey=error"]

    generators:
      - merge:
          mergeKeys:
            - name
          generators:
            - clusters:
                selector:
                  matchLabels:
                    env: downstream
            - list:
                elements:
                  - name: andromeda
                    message: "Welcome to the PRODUCTION cluster: Andromeda 🚀"
                    replicas: 3
                  - name: phoenix
                    message: "Welcome to the STAGING cluster: Phoenix 🔥"
                    replicas: 1

    template:
      metadata:
        name: 'simple-web-{{ .name }}'
      spec:
        project: default
        source:
          repoURL: 'https://github.com/richardpct/helm-example.git'
          targetRevision: HEAD
          path: web
          helm:
            values: |-
              message: "{{ .message }}"
              host: "{{ .name }}.${domain}"
              replicaCount: {{ .replicas }}
        destination:
          name: '{{ .name }}'
          namespace: web
        syncPolicy:
          automated:
            prune: true
            selfHeal: true
          syncOptions:
            - CreateNamespace=true
